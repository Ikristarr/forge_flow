<h1>Your workspaces</h1>

<p>
  <%= link_to "Create a workspace", new_workspace_path %>
</p>

<% if @workspaces.any? %>
  <ul>
    <% @workspaces.each do |workspace| %>
      <li>
        <h2>
          <%= link_to workspace.name, workspace_path(workspace) %>
        </h2>

        <% if workspace.description.present? %>
          <p><%= workspace.description %></p>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>You have not created any workspaces yet.</p>
<% end %>